{
  "manifest_version" : 3,
  "name" : "Scam Defense",
  "version" : "1.0",
  "description" : "AI-powered phishing and scam detection",
  "action" : {
    "default_popup" : "popup.html"
  },
  "permissions" : [
    "storage",
    "tabs"
  ],
  "host_permissions" : [
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background" : {
    "service_worker" : "background.js"
  }
}